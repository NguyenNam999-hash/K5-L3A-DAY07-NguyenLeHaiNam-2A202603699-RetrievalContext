# Copy to .env and fill in. NEVER commit .env.
# Day 6 vector store. The export script can read ../K5-L3-Day06-.../starter/.env
# when DATABASE_URL is omitted here.
DATABASE_URL=postgresql://day6:CHANGE_ME@127.0.0.1:55433/day6_lab
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# OpenAI-compatible agent endpoint. OPENAI_BASE_URL and MODEL are required.
PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4.1-mini
# Optional: this lab endpoint requires a session header.
OPENCODE_SESSION_ID=
